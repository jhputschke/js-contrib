<?xml version="1.0"?>
<!-- Pb+Pb 5.02 TeV, 0-10 % (b < 4.95 fm): the reference copy of
     AuAu_MCGlauber_MUSIC_0_10_jet.xml made with the sed recipe of docs/README_2stage.md
     section 9 (8 lines: Pb nuclei, sqrts 5020, b_max 4.95, MUSIC's grid +-20 fm x +-8, Pythia
     eCM 5020).  b_max: 4.95 fm = the 0-10 % of the experiments' sigma_inel (pi b^2 = 0.1 x
     7.7 b), used now; 5.01 fm = the 0-10 % of this model's own sigma_inel (7.89 b,
     minimum-bias 3dMCGlauber, analysis/zjet/test/centrality_check.py, 2026-10-16), of which
     4.95 fm is 0-9.8 %.  Not switched yet (see <MCGlauber>).
     One event run with it on 2026-10-13 (README_2stage.md section 9); remade on
     2026-10-15 from the EOS 91 template (smash_ready).  Everything else, including most
     comments below, is the Au+Au 200 GeV template's: not tuned at the LHC.
     Use: run_prod_jet.py ... user-xml ../config/PbPb_0_10_jet.xml grid ../config/grid_PbPb.yaml -->

