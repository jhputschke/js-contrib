<!--
  0-10% Au+Au 200 GeV WITH A JET: 3D MC-Glauber (dynamical strings) -> X-SCAPE two-stage
  hydro, written as a background/jet PAIR for FNO4d training data.  Driven by run_prod_jet.py
  in this folder (jetscape.pair_h5.PairH5Writer).

    IS -> Hard -> NullPreDynamics -> MUSIC_1 (background)
       -> Liquefier + Eloss (Matter + LBT)              droplets from the jet's energy loss
       -> MUSIC_2 (same strings + the droplets)         the jet leg

  Derived from AuAu_MCGlauber_MUSIC_0_10_fast.xml.  The <MCGlauber>, <IS>
  grid, <Preequilibrium> and MUSIC physics settings are unchanged (T_fo = 0.15 GeV), except
  EOS 91 (the tunes' EOS; was 9 before 2026-10).  In this Pb+Pb copy the nuclei, sqrts, b_max
  and the <IS> grid are Pb+Pb's (the header above and <MCGlauber> below).  Changes:

    <name> MUSIC_1           the background leg.  Every MUSIC instance reads the FIRST
                             <Hydro><MUSIC> block, so all MUSIC settings live here and apply
                             to both legs; the second block only names MUSIC_2.
    <dump_hydro_only> 0      MUSIC_1 must fill the framework medium: Matter, LBT and the
                             liquefier query the FIRST hydro.  run_prod_jet.py switches
                             dump_hydro_only on for MUSIC_2 alone, after Init.
    added <Hard>             PythiaGun (pTHat range overridable on the command line), or PGun
                             with run_prod_jet.py's pgun option.  Only one may be present: the
                             automatic task list would run both.
    added <Liquefier>        CausalLiquefier.  <dtau> must equal MUSIC's Delta_Tau
                             (music_input, 0.02): the kernel is divided by it and deposited in
                             one hydro step (CausalLiquefier.cc:117-129).  dx/dy/deta are
                             only printed by the C++; set to MUSIC's grid for clarity.
    added <Eloss>            Matter + LBT, settings of FastHydro's
                             AuAu_FastHydro_tune_0_10_wake.xml, <AddLiquefier> true.
    added 2nd <Hydro>        MUSIC_2 with <AddLiquefier> true (false = the null test).

  Needs a MUSIC build with the jet source slot (MUSIC cee9460 / X-SCAPE PR #138 on the CPU;
  the matching MUSIC4GPU port on the GPU).  Without it MUSIC_2 ignores the droplets and
  PairH5Writer warns that the jet leg is identical to the background.

  <nEvents>, <Random><seed>, <setReuseHydro>/<nReuseHydro>, the <Hard> block and MUSIC_2's
  <AddLiquefier> are overwritten per job by run_prod_jet.py.
-->

 <jetscape>

  <!-- General settings -->
  <nEvents> 10 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 1 </nReuseHydro>

  <!-- Technical settings -->
  <debug> off </debug>
  <remark> off </remark>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 10 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>

  <!--  JetScape Writer Settings -->
  <outputFilename>prod_AuAu_0_10_jet</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ>
  <JetScapeWriterHepMC> off </JetScapeWriterHepMC>
  <JetScapeWriterRootHepMC> off </JetScapeWriterRootHepMC>
  <JetScapeWriterFinalStatePartonsAscii> off </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> off </JetScapeWriterFinalStateHadronsAscii>
  <JetScapeWriterQnVectorAscii>off</JetScapeWriterQnVectorAscii>
  <!-- Printing the centrality to the event header is only possible for the Trento initial condition -->
  <write_centrality> 0 </write_centrality>
  <write_pthat> 0 </write_pthat>
  <Writer>
    <!-- Comma separated list of statuses to skip: e.g. "2, 3, 4" -->
    <!-- -9999 corresponds to skipping no status code. It needs to have some entry to be avoid a segfault w/ empty values in tinyxml -->
    <FinalStateHadrons>
       <statusToSkip>-9999</statusToSkip>
       <headerVersion>2</headerVersion>
    </FinalStateHadrons>
    <FinalStatePartons>
       <statusToSkip>-9999</statusToSkip>
       <headerVersion>2</headerVersion>
    </FinalStatePartons>
    <!--JetScapeWriterFinalStateHadronsAscii/JetScapeWriterFinalStatePartonsAscii output in binary mode, only ascii or only binary switch (not both possible at the same time)-->
    <JetscapeWriterFinalStateBinaryOutput> 0 </JetscapeWriterFinalStateBinaryOutput>
  </Writer>

  <!--  Random Settings. For now, just a global  seed. -->
  <!--  Note: It's each modules responsibility to adopt it -->
  <!--  Note: Most if not all modules should understand 0 to mean a random value -->
  <!--  Note: Both 0 and non-zero values require careful treatment in case of multi-threading -->
  <!--  An example implementation is in JetEnergyLossManager.cc -->
  <Random>
    <seed>1</seed>
  </Random>

  <!-- Inital State Module  -->
  <IS>
    <MCGlauber>
      <!--0: generates full event with binary collisions and strings-->
      <!--1: PythiaISR setup (needs 2 step MCGlauber initialization)-->
      <generateOnlyPositions>0</generateOnlyPositions>
      <!--Collision system definitions-->
      <projectile>Pb</projectile> <!--Projectile name-->
      <target>Pb</target> <!--Target name-->
      <sqrts>5020</sqrts> <!--Center of mass energy in GeV-->
      <!--0-10 % IS SELECTED HERE, ON b (b_max below).  Inside X-SCAPE the centrality cut (cenMin/cenMax) does
          nothing: MCGlauberWrapper::ExecuteTask calls EventGenerator::generate_pre_events(),
          which samples b on [b_min, b_max] (P(b) ~ b) and requires only Npart > 1.  The cut on
          cenMin/cenMax (generateMinBiasEventList: 50,000 minimum-bias events ranked by their
          string count) runs only in the standalone 3dMCGlauber main.cpp.  With b_max = 20 this
          file gives MINIMUM-BIAS events.
          b_max: pi b^2 = 0.1 x 7.7 b (the experiments' sigma_inel) = 4.95 fm.  Checked with
          200,000 minimum-bias events of this <MCGlauber> block (standalone 3dMCGlb.e,
          2026-10-16): this model's own sigma_inel is 7.89 b (sigma_NN 67.6 mb), so 4.95 fm is
          its 0-9.8 % (5.01 fm would be 0-10 %).  Its 0-10 % by string count has 95 % of its
          events at b < 4.95 fm, <N_coll> 1,570.-->
      <b_min>0.0</b_min> <!--Minimum impact parameter in fm-->
      <b_max>4.95</b_max> <!--Maximum impact parameter in fm-->
      <cenMin>0.0</cenMin> <!--Minimum centrality in %  (ignored inside X-SCAPE, see above)-->
      <cenMax>10.0</cenMax> <!--Maximum centrality in % (ignored inside X-SCAPE, see above)-->
      <nucleon_configuration_from_file>0</nucleon_configuration_from_file> <!--0: generate nucleon configuration, 1: read from file-->
      <useQuarks>1</useQuarks> <!--Switch to use valence quarks-->
      <Q2>1.0</Q2> <!--Scale when evaluating the PDF-->
      <shadowing_factor>0.0</shadowing_factor> <!--Shadowing factor for producing strings from multiple scatterings-->
      <baryon_junctions>0</baryon_junctions> <!--0: baryon number assumed to be at string end, 1: baryon number transported assuming baryon junctions (at smaller x) see arXiv:nucl-th/9602027-->
      <N_sea_partons>1</N_sea_partons> <!--Number of allowed soft partons-->
      <d_min>0.9</d_min> <!--Minimum distance between two nucleons in fm-->
      <lambdaB>0.2</lambdaB> <!--Strength of the baryon junction stopping-->
      <BG>3.960</BG> <!--Gaussian width square for sampling the valence quark positions (GeV^2)-->
      <Subtract_hard_momentum>0</Subtract_hard_momentum>
      <lambdaBs>0.0</lambdaBs> <!--Fraction of single-to-double junction stopping-->
      <baryonInStringProb>0.0</baryonInStringProb> <!--Relative probility to put a baryon charge in the string rather than at the wounded nucleon remnant-->
      <fluct_Nstrings_per_NN_collision>1</fluct_Nstrings_per_NN_collision> <!--Fluctuate number of strings produced per NN collision-->
      <QCD_string_production_mode>1</QCD_string_production_mode> <!--1: strings are produced randomly in the binary collision list, 2: strings are produced at the last binary collision-->
      <!--Rapidity loss parameters (only mode 4 supported in XML, other modes have to be set in mcglauber.input)-->
      <rapidity_loss_method>4</rapidity_loss_method>
      <ylossParam4At2>1.610</ylossParam4At2>
      <ylossParam4At4>1.685</ylossParam4At4>
      <ylossParam4At6>1.685</ylossParam4At6>
      <ylossParam4At10>2.95</ylossParam4At10>
      <ylossParam4var>0.682</ylossParam4var>
      <remnant_energy_loss_fraction>0.536</remnant_energy_loss_fraction> <!--Nucleon remnant's energy loss fraction (fraction of string's y_loss) [0, 1]-->
      <fluctuation_remnant_energy_loss_fraction>0</fluctuation_remnant_energy_loss_fraction>
      <remnant_energy_loss_fraction_var>0.4</remnant_energy_loss_fraction_var>
      <!--string evolution mode, tau_form = tau_form_mean [fm]-->
      <!--1: deceleration with fixed (90%) rapidity loss (m/sigma = 1 fm, dtau = tau_form)-->
      <!--2: deceleration with LEXUS/parameterized rapidity loss (both dtau and sigma fluctuate)-->
      <!--3: deceleration with LEXUS/parameterized rapidity loss (m/sigma = 1 fm, dtau fluctuates)-->
      <!--4: deceleration with LEXUS/parameterized rapidity loss (dtau = tau_form, m/sigma fluctuates)-->
      <evolve_QCD_string_mode>4</evolve_QCD_string_mode>
      <tau_form_mean>0.424</tau_form_mean> <!--Mean value for tau_form [fm]-->
      <tau_form_fluct_gamma_beta>1.0</tau_form_fluct_gamma_beta> <!--Fluctuation parameter for the gamma distribution-->
    </MCGlauber>

    <grid_max_x> 20 </grid_max_x>
    <grid_max_y> 20 </grid_max_y>
    <grid_max_z> 8  </grid_max_z>
    <grid_step_x> 0.3 </grid_step_x>
    <grid_step_y> 0.3 </grid_step_y>
    <grid_step_z> 0.2 </grid_step_z>
  </IS>

  <!-- Hard process.  PythiaGun uses the hard-scattering vertex sampled from 3dMCGlauber's
       binary collisions (x, y; z = t = 0).  PGun would zero it (PGun.cc:117-120), so every
       shower would start at the origin. -->
  <Hard>
    <PythiaGun>
      <name>PythiaGun</name>
      <FSR_on>0</FSR_on>
      <pTHatMin>50</pTHatMin>
      <pTHatMax>70</pTHatMax>
      <eCM>5020</eCM>
      <softMomentumCutoff>2.0</softMomentumCutoff>
      <LinesToRead>
        HardQCD:all = on
      </LinesToRead>
    </PythiaGun>
  </Hard>

  <!--Preequilibrium Dynamics Module -->
  <Preequilibrium>

    <!-- starting long. proper time for Preequilibrium dynamics -->
    <tau0>0.0</tau0>
    <!-- starting long. proper time for Preequilibrium dynamics output for hard probes -->
    <tauj>0.1</tauj>
    <!-- switching long. proper time from Preequilibrium dynamics to Hydrodynamics (Landau Matching) -->
    <taus>0.5</taus>
    <evolutionInMemory>0</evolutionInMemory>

    <NullPreDynamics> </NullPreDynamics>

  </Preequilibrium>

  <!-- Hydro Module 1: the background leg -->
  <!-- In the user XML file the Hydro section should be placed before Eloss -->
  <Hydro>

    <AddLiquefier> false </AddLiquefier>
    <CartesianHydro> false </CartesianHydro>

    <!-- MUSIC  -->
    <MUSIC>
      <name>MUSIC_1</name>
      <MUSIC_input_file>music_input</MUSIC_input_file>
      <!--EOS used for the hydro evolution: 91 hotQCD EOS (SMASH list), 9 hotQCD EOS (UrQMD list), 20 NEOS-4D-->
      <!--91, the EOS of the tunes (hotQCD + the SMASH hadron list); iSS decays that list itself
          (hadronize.xml decay_smash_list 1, iSS smash_ready).  9 (UrQMD list) for reruns of
          older campaigns: run_prod_jet.py with eos 9-->
      <EOS>91</EOS>
      <!--InitialProfile = 42 for Trento + Pre-equilibrium or IPGlasma, 13 for the 3D Glauber initial condition-->
      <InitialProfile>131</InitialProfile>
      <!--beastMode = 0: double precision, constant time step-->
      <!--beastMode = 1: float precision, constant time step-->
      <!--beastMode = 2: float precision, increased time step after 4 fm/ (can be used for soft sector only runs, otherwise the change in stepsize will lead to errors)-->
      <beastMode>1</beastMode>
      <!--A larger time step from late_tau_switch on (D1, docs/Plans/Final_Optims.md): 0.02 -> 0.05
          fm/c from 3 fm/c, with the freeze-out checks and the stored frames kept at 0.1 fm/c. About
          half the MUSIC steps; the fields change at the level of the time discretization.
          0: a constant step.-->
      <late_delta_tau>0.05</late_delta_tau>
      <late_tau_switch>3.0</late_tau_switch>
      <!--starting time of the hydrodynamic evolution after the pre-equilibrium phase-->
      <Initial_time_tau_0>0.424</Initial_time_tau_0>

      <!--evolution output/storage parameters-->
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <!--When there is a pre-equilibrium stage, and it is kept in memory, this has to be 1-->
      <!--5 x Delta_Tau (0.02, music_input) = 0.1 fm/c between stored frames = the FNO4d dtau-->
      <output_evolution_every_N_timesteps>5</output_evolution_every_N_timesteps>
      <!-- MUSIC's momentum anisotropy / eccentricity .dat files (four serial passes over
           every cell per run); nothing reads them in production. -->
      <output_momentum_anisotropy_vs_etas>0</output_momentum_anisotropy_vs_etas>
      <surface_in_memory>1</surface_in_memory>
      <!--0: MUSIC_1 fills the framework medium for Matter/LBT; MUSIC_2 is switched to 1 in Python-->
      <dump_hydro_only>0</dump_hydro_only>
      <!--do not export a freeze-out surface to the framework-->
      <skip_surface>1</skip_surface>
      <!--0: MUSIC builds no freeze-out surface and stops on max e < e_fo instead (same
          stop step, bit-identical evolution; ~6 s less per MUSIC run). In this first block
          it applies to BOTH legs; the same tag in MUSIC_2's own block overrides it for the
          jet leg (e.g. 1 there to particlize the jet leg). run_prod_jet.py -surface sets
          both from the command line.-->
      <freeze_out_surface>0</freeze_out_surface>

      <!--shear viscosity settings-->
      <shear_viscosity_eta_over_s>0.108</shear_viscosity_eta_over_s>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <!-- Parameters for parametrization 3, the names for these parameters are different compared to JETSCAPE-->
      <shear_viscosity_3_T_kink_in_GeV>0.206</shear_viscosity_3_T_kink_in_GeV>
      <shear_viscosity_3_at_kink>0.108</shear_viscosity_3_at_kink>
      <shear_viscosity_3_low_T_slope_in_GeV>-1.999</shear_viscosity_3_low_T_slope_in_GeV>
      <shear_viscosity_3_high_T_slope_in_GeV>1.999</shear_viscosity_3_high_T_slope_in_GeV>
      <!--mu_B dependent shear viscosity settings-->
      <muB_dependent_Shear_to_S_ratio>0</muB_dependent_Shear_to_S_ratio>
      <!--bulk viscosity settings-->
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      <!-- Parameters for parametrization 3, the names for these parameters are different compared to JETSCAPE-->
      <bulk_viscosity_3_max>0.092</bulk_viscosity_3_max>
      <bulk_viscosity_3_T_peak_in_GeV>0.180</bulk_viscosity_3_T_peak_in_GeV>
      <bulk_viscosity_3_width_in_GeV>0.067</bulk_viscosity_3_width_in_GeV>
      <bulk_viscosity_3_lambda_asymm>-0.8</bulk_viscosity_3_lambda_asymm>
      <!--higher order transport coefficients-->
      <Include_second_order_terms>1</Include_second_order_terms>
      <!--Conserved charge settings-->
      <Include_Rhob>0</Include_Rhob>
      <Include_QS>0</Include_QS>
      <!--freeze-out parameters-->
      <!--0: freeze out at freezeout_temperature; eps_switch is then ignored-->
      <use_eps_for_freeze_out>0</use_eps_for_freeze_out>
      <freezeout_temperature>0.15</freezeout_temperature>
      <eps_switch>0.12</eps_switch>
      <Do_FreezeOut_lowtemp>1</Do_FreezeOut_lowtemp>
      <average_surface_over_this_many_time_steps>5</average_surface_over_this_many_time_steps>
      <!--perform CooperFrye Freezout in MUSIC, not needed when iSS module is used-->
      <Perform_CooperFrye_Freezeout>0</Perform_CooperFrye_Freezeout>
      <!--source term parameters for InitialProfile 13-->
      <string_source_sigma_x>0.207</string_source_sigma_x>
      <string_source_sigma_eta>0.458</string_source_sigma_eta>
      <stringPreEqFlowFactor>0.0</stringPreEqFlowFactor>
    </MUSIC>

  </Hydro>

  <!-- The liquefier: turns the energy the jet loses into droplets for MUSIC_2. -->
  <Liquefier>
    <threshold_energy_switch> 1 </threshold_energy_switch>
    <e_threshold> 2.0 </e_threshold>
    <!-- X-SCAPE with the kernel normalization (LiquefierBase::normalize_active_droplets)
         deposits each droplet exactly on MUSIC's grid by default; the pair file records it
         (liquefier_normalize_on_hydro_grid).  To reproduce older runs add
         <normalize_on_hydro_grid> 0 </normalize_on_hydro_grid> here, but only with such an
         X-SCAPE: an older one stops on the unknown tag (no default in its main XML). -->
    <CausalLiquefier>
      <name>CausalLiquefier</name>
      <dtau> 0.02 </dtau>
      <dx> 0.3 </dx>
      <dy> 0.3 </dy>
      <deta> 0.2 </deta>
      <tau_delay> 1.0 </tau_delay>
      <time_relax> 0.1 </time_relax>
      <d_diff> 0.08 </d_diff>
      <width_delta> 0.1 </width_delta>
    </CausalLiquefier>
  </Liquefier>

  <!-- Energy loss on MUSIC_1's medium.  Matter before Lbt (Matter sets the virtuality Lbt
       takes over at Q0); <mutex>ON</mutex> arbitrates the handover.  recoil_on = 1 gives the
       negative (hole) partons the liquefier also turns into droplets. -->
  <Eloss>
    <deltaT> 0.1 </deltaT>
    <maxT> 20 </maxT>
    <!-- With a hydro (MUSIC) Matter and LBT replace tStart by the hydro's start time,
         MUSIC's tau0 of the run (X-SCAPE tstart_hydro_tau0; recorded per event as
         eloss_tstart): the medium interaction begins with the stored evolution, before it
         the lookup is vacuum.  This value applies only without a hydro. -->
    <tStart> 0.5 </tStart>
    <mutex> ON </mutex>
    <AddLiquefier> true </AddLiquefier>

    <Matter>
      <name> Matter </name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <!-- the start time (MUSIC's tau0) at each point's own proper time, i.e. the events
           of tStart 0 with MUSIC's lookup deciding (X-SCAPE 2026-10-28; default 0) -->
      <tStart_at_point> 1 </tStart_at_point>
      <recoil_on> 1 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
      <hydro_Tc> 0.16 </hydro_Tc>
      <qhat0> -2.0 </qhat0>
      <alphas> 0.25 </alphas>
      <QhatParametrizationType> 1 </QhatParametrizationType>
    </Matter>

    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.25 </alphas>
      <run_alphas> 1 </run_alphas>
    </Lbt>
  </Eloss>

  <!-- Hydro Module 2: the jet leg.  Same strings as MUSIC_1 plus the droplets.  Its MUSIC
       settings come from the first <Hydro><MUSIC> block; only the name and a
       <freeze_out_surface> override are read here. -->
  <Hydro>
    <AddLiquefier> true </AddLiquefier>
    <MUSIC>
      <name>MUSIC_2</name>
    </MUSIC>
  </Hydro>


</jetscape>
