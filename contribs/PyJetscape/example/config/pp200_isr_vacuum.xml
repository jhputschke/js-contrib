<?xml version="1.0"?>
<!--
  p+p 200 GeV hard sector in vacuum, with initial-state radiation: the p+p reference of the
  O+O ISR production and the chain of the RHIC p+p hard tune.  Driven by
  run_prod_oo_isr.py with its option vacuum (prod_OO_isr/README.md, "Vacuum").
    IS (3dMCGlauber, p+p, positions only)
      -> Hard: PythiaIsrGun -> iMATTER (ISR, 0 -> -maxT) -> 3dMCGlauber strings and beam
               remnants from what the hard scattering left (MCGlauberGenString)
      -> Eloss: Matter in vacuum (in_vac 1, no recoils), from -maxT
      -> JetHadronization: iColored          final partons + beam remnants, through the
                                             colour flow (as in O+O, so it cancels in R_AA)
  No <Preequilibrium>, <Hydro> or <Lbt>: the vacuum option removes them from any template
  (the O+O one too); this file simply has none.  3dMCGlauber runs because iColored takes
  the beam remnants' momenta from it.
  The 3dMCGlauber settings are the O+O ones (OO_MCGlauber_MUSIC_isr.xml) with p+p, so that
  the remnants are made the same way in both systems.  b <= 3 fm covers the p+p collisions.
  Cut scheme of the hard tune (RHIC tuning page, step 1): pTHat windows from 5 GeV (above
  iMATTER's floor Q0/sqrt(vir_factor) for vir_factor >= 0.16 at Q0 = 2), cross-section
  weights per window (no bias2Selection), one fixed MPI cut of 5 GeV.  Tune parameters go
  in with the driver's options pythia-line (alpha_s), hadronization-line (probStoUD) or
  edits of a copy of this file (vir_factor, Q0 in <Eloss><Matter>; iMATTER reads them there).
  <nEvents>, <Random><seed>, <Hard><PythiaGun> pTHatMin/pTHatMax/pTHatBins/eCM and
  <IS><MCGlauber> sqrts/b_min/b_max are overwritten per job by run_prod_oo_isr.py.
-->

<jetscape>

  <!-- General settings -->
  <nEvents> 10 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 1 </nReuseHydro>

  <!-- Technical settings -->
  <debug> off </debug>
  <remark> off </remark>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 100 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>

  <!--  JetScape Writer Settings: none, run_prod_oo_isr.py writes HDF5 -->
  <outputFilename>pp_isr_vacuum</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ>
  <JetScapeWriterHepMC> off </JetScapeWriterHepMC>
  <JetScapeWriterRootHepMC> off </JetScapeWriterRootHepMC>
  <JetScapeWriterFinalStatePartonsAscii> off </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> off </JetScapeWriterFinalStateHadronsAscii>
  <JetScapeWriterQnVectorAscii>off</JetScapeWriterQnVectorAscii>
  <write_centrality> 0 </write_centrality>
  <write_pthat> 0 </write_pthat>

  <Random>
    <seed>1</seed>
  </Random>

  <!-- Initial State Module: must come before <Hard> -->
  <IS>
    <MCGlauber>
      <generateOnlyPositions>1</generateOnlyPositions>
      <projectile>p</projectile> <!--Projectile name-->
      <target>p</target> <!--Target name-->
      <sqrts>200</sqrts> <!--Center of mass energy in GeV-->
      <b_min>0.0</b_min> <!--Minimum impact parameter in fm-->
      <b_max>3.0</b_max> <!--Maximum impact parameter in fm-->
      <cenMin>0.0</cenMin> <!--ignored inside X-SCAPE-->
      <cenMax>100</cenMax> <!--ignored inside X-SCAPE-->
      <nucleon_configuration_from_file>0</nucleon_configuration_from_file>
      <useQuarks>1</useQuarks> <!--Switch to use valence quarks-->
      <Q2>1.0</Q2> <!--Scale when evaluating the PDF-->
      <shadowing_factor>0.0</shadowing_factor>
      <baryon_junctions>0</baryon_junctions>
      <N_sea_partons>1</N_sea_partons>
      <d_min>0.9</d_min>
      <lambdaB>0.2</lambdaB>
      <BG>3.960</BG> <!--Gaussian width square for sampling the valence quark positions (GeV^2)-->
      <!--1 with ISR: the hard partons' momentum is taken from the colliding nucleons; what is
          left goes to strings (if any) and to the beam remnants of the jet hadronization-->
      <Subtract_hard_momentum>1</Subtract_hard_momentum>
      <lambdaBs>0.0</lambdaBs>
      <baryonInStringProb>0.0</baryonInStringProb>
      <fluct_Nstrings_per_NN_collision>1</fluct_Nstrings_per_NN_collision>
      <QCD_string_production_mode>1</QCD_string_production_mode>
      <rapidity_loss_method>4</rapidity_loss_method>
      <ylossParam4At2>1.610</ylossParam4At2>
      <ylossParam4At4>1.685</ylossParam4At4>
      <ylossParam4At6>1.685</ylossParam4At6>
      <ylossParam4At10>2.95</ylossParam4At10>
      <ylossParam4var>0.682</ylossParam4var>
      <remnant_energy_loss_fraction>0.536</remnant_energy_loss_fraction>
      <fluctuation_remnant_energy_loss_fraction>0</fluctuation_remnant_energy_loss_fraction>
      <remnant_energy_loss_fraction_var>0.4</remnant_energy_loss_fraction_var>
      <evolve_QCD_string_mode>4</evolve_QCD_string_mode>
      <tau_form_mean>0.5</tau_form_mean>
      <tau_form_fluct_gamma_beta>1.0</tau_form_fluct_gamma_beta>
    </MCGlauber>
  </IS>

  <!-- Hard process.  PythiaIsrGun reads the PythiaGun block; <ISR> switches the ISR chain on
       (maxT/deltaT: 0 = the <Eloss> values).  MPI cut 5 GeV: below the lowest window's
       lower edge (with the MPI cut at 8 GeV Pythia switches MPI off at 200 GeV). -->
  <Hard>
    <PythiaGun>
      <name>PythiaGun</name>
      <FSR_on>0</FSR_on>
      <pTHatMin>5</pTHatMin>
      <pTHatMax>60</pTHatMax>
      <eCM>200</eCM>
      <LinesToRead>
        HardQCD:all = on
        MultipartonInteractions:pTmin = 5.0
      </LinesToRead>
    </PythiaGun>
    <ISR>
      <maxT>0</maxT>
      <deltaT>0</deltaT>
    </ISR>
  </Hard>

  <!-- Final-state shower in vacuum.  maxT is also the ISR range: iMATTER showers back to
       -maxT and Matter starts there.  iMATTER reads Q0 and vir_factor from <Matter>. -->
  <Eloss>
    <deltaT> 0.1 </deltaT>
    <maxT> 50 </maxT>
    <Matter>
      <name> Matter </name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 0 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
    </Matter>
  </Eloss>

  <!-- Jet hadronization: the final partons and the beam remnants through the ISR colour
       flow, as in O+O.  In vacuum no colour line ends in a medium, so <colour_closure> has
       nothing to close; kept as in the O+O XML. -->
  <JetHadronization>
    <name>iColored</name>
    <colour_closure>reconnect</colour_closure>
  </JetHadronization>

</jetscape>
