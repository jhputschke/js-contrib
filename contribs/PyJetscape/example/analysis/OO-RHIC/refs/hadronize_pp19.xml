<?xml version="1.0"?>
<!-- analysis/OO-RHIC/refs/hadronize_pp19.xml: config/hadronize.xml's JetHadronization block
     (Colorless, eCMforHadronization 200, decays c tau < 1 cm) with pi0 and eta undecayed, for
     the PP19 reference (run_prod_vacuum.py, option hadronize-xml). -->
<jetscape>
  <JetHadronization>
    <name>colorless</name>
    <take_recoil>1</take_recoil>
    <eCMforHadronization>200</eCMforHadronization>
    <pythia_decays>on</pythia_decays>
    <tau0Max>10.0</tau0Max>
    <!-- 1: every event reseeds Pythia from the module's generator and records the seed,
         so an event can be reproduced on its own (hadronize.py always passes a seed) -->
    <reseed_per_event>1</reseed_per_event>
    <LinesToRead>
      111:mayDecay = off
      221:mayDecay = off
    </LinesToRead>
  </JetHadronization>
</jetscape>
