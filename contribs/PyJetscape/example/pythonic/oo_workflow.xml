<?xml version="1.0"?>
<!--
  example/pythonic/oo_workflow.xml: the user XML of oo_workflow.ipynb.

  O+O 200 GeV, 3 events, seed 7: 3dMCGlauber (b < 3 fm) -> PythiaIsrGun (pTHat 20-40 GeV,
  both hard partons at |y| < 0.6) -> iMATTER (ISR) -> 3dMCGlauber strings -> MUSIC
  (music4gpu, EOS 91) -> Matter + LBT -> iColoredHadronization (<colour_closure>reconnect,
  reseeded per event) -> iSS on MUSIC's surface, 20 oversamples per event.

  Made once from the O+O production's template (../config/OO_MCGlauber_MUSIC_isr.xml) by
  job_xml() of ../prod_OO_isr/run_prod_oo_isr.py, with its options events 3, seed 7,
  pthat-min 20, pthat-max 40, parton-ymax 0.6, bulk-hadrons 20, no-hydro-file and
  no-particlize, so it runs the production's physics settings. The iSS paths start with '../' (relative to
  the X-SCAPE build directory): the notebook makes them absolute for its build.
-->
<jetscape>
  <nEvents> 3 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 1 </nReuseHydro>
  <debug> off </debug>
  <remark> off </remark>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 10 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>
  <outputFilename>prod_OO_isr</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ>
  <JetScapeWriterHepMC> off </JetScapeWriterHepMC>
  <JetScapeWriterRootHepMC> off </JetScapeWriterRootHepMC>
  <JetScapeWriterFinalStatePartonsAscii> off </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> off </JetScapeWriterFinalStateHadronsAscii>
  <JetScapeWriterQnVectorAscii>off</JetScapeWriterQnVectorAscii>
  <write_centrality> 0 </write_centrality>
  <write_pthat> 0 </write_pthat>
  <Random>
    <seed>7</seed>
  </Random>
  <IS>
    <MCGlauber>
      <generateOnlyPositions>1</generateOnlyPositions>
      <projectile>O</projectile>
      <target>O</target>
      <sqrts>200</sqrts>
      <b_min>0.0</b_min>
      <b_max>3.0</b_max>
      <cenMin>0.0</cenMin>
      <cenMax>80</cenMax>
      <nucleon_configuration_from_file>1</nucleon_configuration_from_file>
      <useQuarks>1</useQuarks>
      <Q2>1.0</Q2>
      <shadowing_factor>0.0</shadowing_factor>
      <baryon_junctions>0</baryon_junctions>
      <N_sea_partons>1</N_sea_partons>
      <d_min>0.9</d_min>
      <lambdaB>0.2</lambdaB>
      <BG>3.960</BG>
      <Subtract_hard_momentum>1</Subtract_hard_momentum>
      <lambdaBs>0.0</lambdaBs>
      <baryonInStringProb>0.0</baryonInStringProb>
      <fluct_Nstrings_per_NN_collision>1</fluct_Nstrings_per_NN_collision>
      <QCD_string_production_mode>1</QCD_string_production_mode>
      <rapidity_loss_method>4</rapidity_loss_method>
      <ylossParam4At2>1.610</ylossParam4At2>
      <ylossParam4At4>1.685</ylossParam4At4>
      <ylossParam4At6>1.685</ylossParam4At6>
      <ylossParam4At10>2.95</ylossParam4At10>
      <ylossParam4var>0.682</ylossParam4var>
      <remnant_energy_loss_fraction>0.536</remnant_energy_loss_fraction>
      <fluctuation_remnant_energy_loss_fraction>0</fluctuation_remnant_energy_loss_fraction>
      <remnant_energy_loss_fraction_var>0.4</remnant_energy_loss_fraction_var>
      <evolve_QCD_string_mode>4</evolve_QCD_string_mode>
      <tau_form_mean>0.5</tau_form_mean>
      <tau_form_fluct_gamma_beta>1.0</tau_form_fluct_gamma_beta>
    </MCGlauber>
    <grid_max_x> 10.5 </grid_max_x>
    <grid_max_y> 10.5 </grid_max_y>
    <grid_max_z> 6  </grid_max_z>
    <grid_step_x> 0.3 </grid_step_x>
    <grid_step_y> 0.3 </grid_step_y>
    <grid_step_z> 0.2 </grid_step_z>
  </IS>
  <Hard>
    <PythiaGun>
      <name>PythiaGun</name>
      <FSR_on>0</FSR_on>
      <pTHatMin> 20 </pTHatMin>
      <pTHatMax> 40 </pTHatMax>
      <eCM>200</eCM>
      <LinesToRead>
        HardQCD:all = on
      </LinesToRead>
      <partonYMax> 0.6 </partonYMax>
      <partonYMode> both </partonYMode>
    </PythiaGun>
    <ISR>
      <maxT>0</maxT>
      <deltaT>0</deltaT>
    </ISR>
  </Hard>
  <Preequilibrium>
    <tau0>0.0</tau0>
    <taus>0.5</taus>
    <evolutionInMemory>0</evolutionInMemory>
    <NullPreDynamics> </NullPreDynamics>
  </Preequilibrium>
  <Hydro>
    <MUSIC>
      <name>MUSIC</name>
      <MUSIC_input_file>music_input</MUSIC_input_file>
      <EOS>91</EOS>
      <InitialProfile>131</InitialProfile>
      <beastMode>1</beastMode>
      <late_delta_tau>0.05</late_delta_tau>
      <late_tau_switch>3.0</late_tau_switch>
      <Initial_time_tau_0>0.424</Initial_time_tau_0>
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <output_evolution_every_N_timesteps>5</output_evolution_every_N_timesteps>
      <output_momentum_anisotropy_vs_etas>0</output_momentum_anisotropy_vs_etas>
      <surface_in_memory>1</surface_in_memory>
      <dump_hydro_only>0</dump_hydro_only>
      <slim_bulk_info> 1 </slim_bulk_info>
      <skip_surface> 0 </skip_surface>
      <freeze_out_surface> 1 </freeze_out_surface>
      <shear_viscosity_eta_over_s>0.108</shear_viscosity_eta_over_s>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <shear_viscosity_3_T_kink_in_GeV>0.206</shear_viscosity_3_T_kink_in_GeV>
      <shear_viscosity_3_at_kink>0.108</shear_viscosity_3_at_kink>
      <shear_viscosity_3_low_T_slope_in_GeV>-1.999</shear_viscosity_3_low_T_slope_in_GeV>
      <shear_viscosity_3_high_T_slope_in_GeV>1.999</shear_viscosity_3_high_T_slope_in_GeV>
      <muB_dependent_Shear_to_S_ratio>0</muB_dependent_Shear_to_S_ratio>
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      <bulk_viscosity_3_max>0.092</bulk_viscosity_3_max>
      <bulk_viscosity_3_T_peak_in_GeV>0.180</bulk_viscosity_3_T_peak_in_GeV>
      <bulk_viscosity_3_width_in_GeV>0.067</bulk_viscosity_3_width_in_GeV>
      <bulk_viscosity_3_lambda_asymm>-0.8</bulk_viscosity_3_lambda_asymm>
      <Include_second_order_terms>1</Include_second_order_terms>
      <Include_Rhob>0</Include_Rhob>
      <Include_QS>0</Include_QS>
      <use_eps_for_freeze_out>0</use_eps_for_freeze_out>
      <freezeout_temperature>0.15</freezeout_temperature>
      <eps_switch>0.12</eps_switch>
      <Do_FreezeOut_lowtemp>1</Do_FreezeOut_lowtemp>
      <average_surface_over_this_many_time_steps>5</average_surface_over_this_many_time_steps>
      <Perform_CooperFrye_Freezeout>0</Perform_CooperFrye_Freezeout>
      <string_source_sigma_x>0.207</string_source_sigma_x>
      <string_source_sigma_eta>0.458</string_source_sigma_eta>
      <stringPreEqFlowFactor>0.0</stringPreEqFlowFactor>
    </MUSIC>
  </Hydro>
  <Eloss>
    <deltaT> 0.1 </deltaT>
    <maxT> 50 </maxT>
    <tStart> 0.5 </tStart>
    <mutex> ON </mutex>
    <Matter>
      <name> Matter </name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <!-- the start time (MUSIC's tau0) at each point's own proper time, i.e. the events
           of tStart 0 with MUSIC's lookup deciding (X-SCAPE 2026-10-28; default 0) -->
      <tStart_at_point> 1 </tStart_at_point>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 1 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
      <hydro_Tc> 0.16 </hydro_Tc>
      <qhat0> -2.0 </qhat0>
      <alphas> 0.25 </alphas>
      <QhatParametrizationType> 1 </QhatParametrizationType>
    </Matter>
    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.25 </alphas>
      <run_alphas> 1 </run_alphas>
    </Lbt>
  </Eloss>
  <JetHadronization>
    <name>iColored</name>
    <colour_closure>reconnect</colour_closure>
    <reseed_per_event> 1 </reseed_per_event>
    <store_input> 0 </store_input>
  </JetHadronization>
  <SoftParticlization>
    <hydro_id>MUSIC</hydro_id>
    <iSS>
      <hydro_mode>2</hydro_mode>
      <iSS_input_file>../external_packages/iSS/iSS_parameters.dat</iSS_input_file>
      <iSS_working_path>.</iSS_working_path>
      <iSS_table_path>../external_packages/iSS/iSS_tables</iSS_table_path>
      <iSS_particle_table_path>../external_packages/iSS/iSS_tables</iSS_particle_table_path>
      <afterburner_type>1</afterburner_type>
      <include_deltaf_shear>1</include_deltaf_shear>
      <include_deltaf_bulk>1</include_deltaf_bulk>
      <deltaf_type>20</deltaf_type>
      <number_of_repeated_sampling> 20 </number_of_repeated_sampling>
      <Perform_resonance_decays>1</Perform_resonance_decays>
      <decay_smash_list>1</decay_smash_list>
      <keep_primaries> 0 </keep_primaries>
    </iSS>
  </SoftParticlization>
</jetscape>
