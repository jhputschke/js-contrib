<?xml version="1.0"?>
<!-- example/python_modules/run_by_hand.py: the modules are added in Python, not read from
     here; this file only sets the run (events, seed) and the energy-loss time steps -->
<jetscape>
  <nEvents>3</nEvents>
  <vlevel>0</vlevel>
  <Random><seed>1</seed></Random>
  <enableAutomaticTaskListDetermination> false </enableAutomaticTaskListDetermination>
  <Eloss>
    <deltaT>0.1</deltaT>
    <maxT>2</maxT>
  </Eloss>
  <Afterburner>
    <include_fragmentation_hadrons>1</include_fragmentation_hadrons>
    <output_only_final_state_hadrons>0</output_only_final_state_hadrons>
  </Afterburner>
</jetscape>
